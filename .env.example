# Copiar a .env para desarrollo local. En Railway se definen como Variables del servicio.

# Obligatoria fuera de desarrollo. Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Administrador inicial (se crea solo si no existe). Contraseña de 12+ caracteres.
# ADMIN_EMAIL es el correo al que llegará el código de "¿Olvidaste tu contraseña?".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Ruta de la base SQLite. En Railway: montar un Volume en /data y usar /data/sistema_planillas.db
DATABASE_PATH=

# Saltos de proxy de confianza para IP/HTTPS reales (Railway = 1). Usar 0 en local sin proxy.
PROXY_HOPS=1

# Correo de recuperación de contraseña (API HTTP de EmailJS, llamada desde el servidor).
# En EmailJS: Account > Security > activar "Allow EmailJS API for non-browser applications".
# La plantilla debe usar las variables {{to_email}}, {{otp_code}} y {{tiempo_limite}}.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_OTP=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Solo desarrollo local: 1 carga usuarios y empleados de demostración (contraseñas conocidas)
# y, sin EmailJS configurado, el código de recuperación se imprime en la consola del servidor.
SEED_DEMO_DATA=0
FLASK_DEBUG=0
